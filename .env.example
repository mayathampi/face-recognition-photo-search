APP_NAME="Face Recognition API"
API_PREFIX=/api/v1
ROOT_PATH=
CORS_ORIGINS=*
LOG_LEVEL=INFO

GALLERY_DIR=data/images
EMBEDDINGS_PATH=data/embeddings/gallery.npz

MODEL_NAME=buffalo_l
